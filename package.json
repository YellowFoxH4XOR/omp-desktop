{
  "name": "pidesk",
  "version": "0.1.0",
  "description": "πDesk — a local desktop app for Pi coding-agent sessions",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun run check:frontend && bun run check:rust",
    "check:frontend": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "cd src-tauri && cargo fmt -- --check && cargo check --locked",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:watch": "vitest --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test tests/e2e",
    "test:rust": "cd src-tauri && cargo test --locked",
    "validate": "./scripts/validate.sh",
    "bundle:macos": "bun run tauri build --bundles app && ./scripts/sign-macos-bundle.sh"
  },
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.47.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "shiki": "^4.4.3",
    "virtua": "^0.52.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
